# =============================================================================
# emalify-sms-mno-gateway Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=info
WORKER_COUNT=10

# HTTP Server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_PREFETCH=10
RABBITMQ_RECONNECT_WAIT=5s

# Input Queues (comma-separated list)
INPUT_QUEUES=TITANIC-KE_SMS_QUEUE,CONSUME_TO_MNO,SMS_MNO_GATEWAY_QUEUE

# Output Queues
SAVE_TO_DB_QUEUE=SAVE_TO_DB
SMS_RETRY_QUEUE=SMS_RETRY_QUEUE
SMS_DEAD_LETTER_QUEUE=SMS_DEAD_LETTER_QUEUE

# =============================================================================
# MNO Configuration
# =============================================================================

# Safaricom SDP (Non-Transactional)
SDP_AUTH_URL=https://api.safaricom.com/auth/login
SDP_SEND_URL=https://api.safaricom.com/sms/bulksms
# Auth username for token endpoint
SDP_USERNAME=your_sdp_auth_username
# Payload userName for send endpoint
SDP_USER=your_sdp_username
SDP_PASSWORD=your_sdp_password
SDP_DLR_URL=https://your-domain.com/dlr/safaricom
SDP_TOKEN_KEY=SDP_TOKEN_KEY
SDP_TOKEN_TTL=25m

# Safaricom SMPP (Transactional via Kannel)
SAFARICOM_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
SAFARICOM_SMPP_SMSC=SAFARICOM
SAFARICOM_SMPP_USERNAME=your_smpp_username
SAFARICOM_SMPP_PASSWORD=your_smpp_password
SAFARICOM_SMPP_DLR_URL=http://your-dlr-host:port/save

# Airtel (via Kannel)
AIRTEL_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
AIRTEL_SMPP_SMSC=AIRTEL
AIRTEL_SMPP_USERNAME=your_airtel_username
AIRTEL_SMPP_PASSWORD=your_airtel_password
AIRTEL_SMPP_DLR_URL=http://your-dlr-host:port/save

# Telkom (via Kannel)
TELKOM_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
TELKOM_SMPP_SMSC=TELKOM
TELKOM_SMPP_USERNAME=your_telkom_username
TELKOM_SMPP_PASSWORD=your_telkom_password
TELKOM_SMPP_DLR_URL=http://your-dlr-host:port/save

# Equitel (via Kannel)
EQUITEL_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
EQUITEL_SMPP_SMSC=EQUITEL
EQUITEL_SMPP_USERNAME=your_equitel_username
EQUITEL_SMPP_PASSWORD=your_equitel_password
EQUITEL_SMPP_DLR_URL=http://your-dlr-host:port/save

# CM / International (via Kannel)
CM_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
CM_SMPP_SMSC=CM
CM_SMPP_USERNAME=your_cm_username
CM_SMPP_PASSWORD=your_cm_password
CM_SMPP_DLR_URL=http://your-dlr-host:port/save

# =============================================================================
# Rate Limits (requests per second)
# =============================================================================
RATE_LIMIT_SAFARICOM=200
RATE_LIMIT_AIRTEL=50
RATE_LIMIT_TELKOM=100
RATE_LIMIT_EQUITEL=20
RATE_LIMIT_CM=20
RATE_LIMIT_DEFAULT=20

# =============================================================================
# Priority Routing (EM-155) - Credit-Based Weighted Round Robin
# =============================================================================
# Enable priority-based message routing
# When enabled:
# - Transactional messages (packageId="TRANSACTIONAL") use fast-path with dedicated workers
# - Promotional messages use Credit-Based Weighted Round Robin (WRR) scheduling
PRIORITY_ROUTING_ENABLED=false

# Redis key for storing queue weights (used for hot-reload via Pub/Sub)
PRIORITY_REDIS_WEIGHTS_KEY=sms:priority:queue_weights

# Default queue weights (format: queue1:weight1,queue2:weight2,...)
# Higher weight = higher priority (more credits per refill cycle)
# Example: GOLD_PARTNERS_QUEUE:10,TITANIC-KE_SMS_QUEUE:1
PRIORITY_DEFAULT_WEIGHTS=

# Default weight for queues not explicitly configured
PRIORITY_DEFAULT_WEIGHT=1

# Number of dedicated workers for transactional messages (fast-path)
PRIORITY_TRANSACTIONAL_WORKERS=5

# -----------------------------------------------------------------------------
# Credit-Based WRR Algorithm Configuration
# -----------------------------------------------------------------------------
# Credits per weight unit (capacity = weight × multiplier)
# Example: weight=10, multiplier=10 → 100 credits capacity
PRIORITY_CREDIT_MULTIPLIER=10

# Credit refill interval in milliseconds
# Lower = smoother distribution, higher = more burst-friendly
PRIORITY_REFILL_PERIOD_MS=100

# Maximum seconds without processing before starvation prevention kicks in
# Queues exceeding this age get priority regardless of credits
PRIORITY_MAX_STARVATION_AGE_SEC=10

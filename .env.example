# =============================================================================
# emalify-sms-mno-gateway Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=info
WORKER_COUNT=250

# HTTP Server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Should be >= WORKER_COUNT to keep all goroutines fed (fan-out fix)
RABBITMQ_PREFETCH=500
RABBITMQ_RECONNECT_WAIT=5s

# Input Queues (comma-separated list)
INPUT_QUEUES=TITANIC-KE_SMS_QUEUE,CONSUME_TO_MNO,SMS_MNO_GATEWAY_QUEUE

# Per-queue SDP batch sizes (EM-1102) — promotional Safaricom messages per API call
# Format: queue1:batchsize,queue2:batchsize (omit or set to 1 to disable batching for a queue)
# Queues not listed here fall back to the global SDP_PROMO_BATCH_SIZE default
# Example: SMS_MNO_GATEWAY_QUEUE:50,TITANIC-KE_SMS_QUEUE:100
QUEUE_SDP_BATCH_SIZES=

# Output Queues
SAVE_TO_DB_QUEUE=SAVE_TO_DB
SMS_DEAD_LETTER_QUEUE=SMS_DEAD_LETTER_QUEUE

# Legacy retry queue — kept in INPUT_QUEUES until depth reaches zero, then remove
SMS_RETRY_QUEUE=SMS_RETRY_QUEUE

# Split retry queues (EM-1055) — transactional and promotional processed independently
SMS_TRANSACTIONAL_RETRY_QUEUE=SMS_TRANSACTIONAL_RETRY_QUEUE
SMS_PROMOTIONAL_RETRY_QUEUE=SMS_PROMOTIONAL_RETRY_QUEUE
SMS_TRANSACTIONAL_DELAY_QUEUE=SMS_TRANSACTIONAL_DELAY_QUEUE
SMS_PROMOTIONAL_DELAY_QUEUE=SMS_PROMOTIONAL_DELAY_QUEUE

# =============================================================================
# MNO Configuration
# =============================================================================

# Safaricom SDP (Non-Transactional)
SDP_AUTH_URL=https://api.safaricom.com/auth/login
SDP_SEND_URL=https://api.safaricom.com/sms/bulksms
# Auth username for token endpoint
SDP_USERNAME=your_sdp_auth_username
# Payload userName for send endpoint
SDP_USER=your_sdp_username
SDP_PASSWORD=your_sdp_password
SDP_DLR_URL=https://your-domain.com/dlr/safaricom
SDP_DLR_URL_API_V2=https://your-api-v2-dlr-host/dlr/safaricom
SDP_TOKEN_KEY=SDP_TOKEN_KEY
SDP_TOKEN_TTL=25m

# Queue-based DLR routing
# Messages from GATEWAY_QUEUE_NAME use the primary DLR URLs (e.g. AIRTEL_SMPP_DLR_URL)
# Messages from any other input queue use the _API_V2 DLR URLs
# Falls back to primary DLR URL if _API_V2 is not set
GATEWAY_QUEUE_NAME=SMS_MNO_GATEWAY_QUEUE

# Safaricom SMPP (Transactional via Kannel)
SAFARICOM_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
SAFARICOM_SMPP_SMSC=SAFARICOM
SAFARICOM_SMPP_USERNAME=your_smpp_username
SAFARICOM_SMPP_PASSWORD=your_smpp_password
SAFARICOM_SMPP_DLR_URL=http://your-dlr-host:port/save
SAFARICOM_SMPP_DLR_URL_API_V2=http://your-api-v2-dlr-host:port/save

# Airtel Transactional (via Kannel)
AIRTEL_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
AIRTEL_SMPP_SMSC=AIRTEL
AIRTEL_SMPP_USERNAME=your_airtel_username
AIRTEL_SMPP_PASSWORD=your_airtel_password
AIRTEL_SMPP_DLR_URL=http://your-dlr-host:port/save
AIRTEL_SMPP_DLR_URL_API_V2=http://your-api-v2-dlr-host:port/save

# Airtel Promotional (via Kannel)
# Falls back to transactional credentials if not set
AIRTEL_SMPP_URL_PROMO=http://kannel-host:port/cgi-bin/sendsms
AIRTEL_SMPP_SMSC_PROMO=AIRTEL
AIRTEL_SMPP_USERNAME_PROMO=your_airtel_promo_username
AIRTEL_SMPP_PASSWORD_PROMO=your_airtel_promo_password
AIRTEL_SMPP_DLR_URL_PROMO=http://your-dlr-host:port/save
AIRTEL_SMPP_DLR_URL_PROMO_API_V2=http://your-api-v2-dlr-host:port/save

# Telkom (via Kannel)
TELKOM_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
TELKOM_SMPP_SMSC=TELKOM
TELKOM_SMPP_USERNAME=your_telkom_username
TELKOM_SMPP_PASSWORD=your_telkom_password
TELKOM_SMPP_DLR_URL=http://your-dlr-host:port/save
TELKOM_SMPP_DLR_URL_API_V2=http://your-api-v2-dlr-host:port/save

# Equitel (via Kannel)
EQUITEL_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
EQUITEL_SMPP_SMSC=EQUITEL
EQUITEL_SMPP_USERNAME=your_equitel_username
EQUITEL_SMPP_PASSWORD=your_equitel_password
EQUITEL_SMPP_DLR_URL=http://your-dlr-host:port/save
EQUITEL_SMPP_DLR_URL_API_V2=http://your-api-v2-dlr-host:port/save

# CM / International (via Kannel)
CM_SMPP_URL=http://kannel-host:port/cgi-bin/sendsms
CM_SMPP_SMSC=CM
CM_SMPP_USERNAME=your_cm_username
CM_SMPP_PASSWORD=your_cm_password
CM_SMPP_DLR_URL=http://your-dlr-host:port/save

# =============================================================================
# Rate Limits — Main Queue Budgets (requests per second)
# =============================================================================
RATE_LIMIT_SAFARICOM=700
RATE_LIMIT_AIRTEL=150
RATE_LIMIT_TELKOM=100
RATE_LIMIT_EQUITEL=50
RATE_LIMIT_CM=20
RATE_LIMIT_DEFAULT=150

# =============================================================================
# Retry Queue Separation (EM-1055)
# =============================================================================

# Fixed delay before a failed message re-enters the active retry queue (milliseconds)
# Transactional: short delay to preserve OTP/banking urgency
# Promotional: longer delay prevents MNO hammering during degradation
RETRY_TRANSACTIONAL_DELAY_MS=5000
RETRY_PROMOTIONAL_DELAY_MS=30000

# Dedicated retry worker pools — sized above rate limit ceiling so the limiter binds
RETRY_TRANSACTIONAL_WORKER_COUNT=50
RETRY_TRANSACTIONAL_PREFETCH=100
RETRY_PROMOTIONAL_WORKER_COUNT=200
RETRY_PROMOTIONAL_PREFETCH=400

# Per-network rate limit reserved for retry queues (TPS)
# Combined main + retry must not exceed MNO contract limit
RATE_LIMIT_RETRY_SAFARICOM_SDP=200
RATE_LIMIT_RETRY_SAFARICOM_SMPP=40
RATE_LIMIT_RETRY_AIRTEL=5
RATE_LIMIT_RETRY_EQUITEL=10
RATE_LIMIT_RETRY_TELKOM=10
RATE_LIMIT_RETRY_CM=5

# BurstFactor: retry can use up to (reserved × factor) TPS when main queues are idle
# 1 = strict reservation, 2 = doubles burst during low main-queue load
RATE_LIMIT_RETRY_BURST_FACTOR=1

# Max retry attempts before routing to DLQ
# Transactional: 5 retries × 5s = ~25s max lifetime (OTPs expire, no point retrying further)
# Promotional: 10 retries × 30s = ~5min max lifetime
RETRY_MAX_RETRIES_TRANSACTIONAL=5
RETRY_MAX_RETRIES_PROMOTIONAL=10

# =============================================================================
# Priority Routing (EM-155) - Credit-Based Weighted Round Robin
# =============================================================================
# Enable priority-based message routing
# When enabled:
# - Transactional messages (packageId="TRANSACTIONAL") use fast-path with dedicated workers
# - Promotional messages use Credit-Based Weighted Round Robin (WRR) scheduling
PRIORITY_ROUTING_ENABLED=false

# Redis key for storing queue weights (used for hot-reload via Pub/Sub)
PRIORITY_REDIS_WEIGHTS_KEY=sms:priority:queue_weights

# Default queue weights (format: queue1:weight1,queue2:weight2,...)
# Higher weight = higher priority (more credits per refill cycle)
# Example: GOLD_PARTNERS_QUEUE:10,TITANIC-KE_SMS_QUEUE:1
PRIORITY_DEFAULT_WEIGHTS=

# Default weight for queues not explicitly configured
PRIORITY_DEFAULT_WEIGHT=1

# Number of dedicated workers for transactional messages (fast-path)
PRIORITY_TRANSACTIONAL_WORKERS=5

# -----------------------------------------------------------------------------
# Credit-Based WRR Algorithm Configuration
# -----------------------------------------------------------------------------
# Credits per weight unit (capacity = weight × multiplier)
# Example: weight=10, multiplier=10 → 100 credits capacity
PRIORITY_CREDIT_MULTIPLIER=10

# Credit refill interval in milliseconds
# Lower = smoother distribution, higher = more burst-friendly
PRIORITY_REFILL_PERIOD_MS=100

# Maximum seconds without processing before starvation prevention kicks in
# Queues exceeding this age get priority regardless of credits
PRIORITY_MAX_STARVATION_AGE_SEC=10
